{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AMC",
  "version": "0.6.3",
  "identifier": "com.amc.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AMC · Agent Manager Center",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'",
      "devCsp": "default-src * 'unsafe-inline' 'unsafe-eval' data: blob:; connect-src * ws: wss: http://localhost:1420 ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGMTNFNTNBMUE3QjIwNTMKUldSVElIc2FPdVVUdnd4cldxUnNzTlpBL2tOK0V6L1VyUS9uT0xzejBPeDJXdWpvR1M2aURvLzUK",
      "endpoints": [
        "https://github.com/BenZinaDaze/amc/releases/latest/download/latest.json"
      ]
    }
  }
}
