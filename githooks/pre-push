#!/bin/sh
# Blocks tag pushes when the release notes file is missing or empty.
# Enable once per clone: git config core.hooksPath githooks
zero=0000000000000000000000000000000000000000
status=0
# git sends one "<local-ref> <local-oid> <remote-ref> <remote-oid>" line
# per ref; the remote side is the one being updated.
while read -r _local_ref _local_oid remote_ref remote_oid; do
  case "$remote_ref" in refs/tags/v*) ;; *) continue ;; esac
  [ "$remote_oid" = "$zero" ] && continue
  tag=${remote_ref#refs/tags/}
  notes="docs/releases/$tag.md"
  if [ ! -s "$notes" ] || ! grep -q '[^[:space:]]' "$notes"; then
    echo "push declined: $notes is missing or empty — write the release notes before pushing $tag" >&2
    status=1
  fi
done
exit $status
