#!/bin/sh
# Blocks tag pushes when the release notes file is missing, empty, or does
# not explicitly acknowledge every feat commit added since the previous
# tag.
# Enable once per clone: git config core.hooksPath githooks
zero=0000000000000000000000000000000000000000
status=0

# git sends one "<local-ref> <local-oid> <remote-ref> <remote-oid>" line
# per ref. A deletion empties the LOCAL side; creating or updating a tag
# keeps a real local oid, and that is the push the gate must verify.
while read -r local_ref local_oid _remote_ref _remote_oid; do
  case "$local_ref" in refs/tags/v*) ;; *) continue ;; esac
  [ "$local_oid" = "$zero" ] && continue
  tag=${local_ref#refs/tags/}
  notes="docs/releases/$tag.md"
  if [ ! -s "$notes" ] || ! grep -q '[^[:space:]]' "$notes"; then
    echo "push declined: $notes is missing or empty — write the release notes before pushing $tag" >&2
    status=1
    continue
  fi
  # The notes must acknowledge every feat commit between the previous tag
  # and this one — not only the newest feature. Each acknowledgement is a
  # hidden HTML comment carrying the commit oid:
  #
  #   <!--feat:<commit-oid>-->
  #
  # Sharing words with the notes is not coverage: "codex" contains "code",
  # so a Codex-only file would otherwise pass for a Claude Code feat.
  prev=$(git describe --tags --abbrev=0 "$local_oid"^ 2>/dev/null) || continue
  notes_body=$(cat "$notes")
  missing=$(git log "$prev..$local_oid" --no-merges --pretty='%H %s' \
    | grep -E '^[0-9a-f]{40} feat(\(|:)' \
    | while IFS= read -r record; do
        oid=${record%% *}
        # grep -F keeps the marker a plain argument: "<" and ">" inside a
        # case pattern misparse inside command substitution.
        if printf '%s\n' "$notes_body" | grep -qF -- "<!--feat:$oid-->"; then
          :
        else
          printf '%s\n' "$record"
        fi
      done)
  if [ -n "$missing" ]; then
    echo "push declined: $notes does not acknowledge these feat commits since $prev:" >&2
    printf '%s\n' "$missing" >&2
    echo "append the matching hidden comment for each commit" >&2
    printf '%s\n' "$missing" \
      | while IFS= read -r record; do
          oid=${record%% *}
          printf '  <!--feat:%s-->\n' "$oid" >&2
        done
    echo "(paste the comments anywhere into $notes, e.g. at the end) before pushing $tag" >&2
    status=1
  fi
done
exit $status
