#!/bin/sh
# Blocks tag pushes when the release notes file is missing, empty, or does
# not explicitly acknowledge every feat commit added since the previous
# tag. A verified tag also kicks off a background cargo clean: the
# release is CI's job from here, so the local build tree is dropped
# right away — a failed CI run simply pays a full local rebuild.
# Enable once per clone: git config core.hooksPath githooks
zero=0000000000000000000000000000000000000000
status=0
releasing=0

# git sends one "<local-ref> <local-oid> <remote-ref> <remote-oid>" line
# per ref. The REMOTE ref is what will be created — the release tag and
# notes file follow it, even when the source is a renamed refspec
# ("git push origin HEAD:refs/tags/v0.4.0" sends local-ref "HEAD"). A
# deletion empties the LOCAL side; creating or updating a tag keeps a
# real local oid, and that is the push the gate must verify.
while read -r _local_ref local_oid remote_ref _remote_oid; do
  case "$remote_ref" in refs/tags/v*) ;; *) continue ;; esac
  [ "$local_oid" = "$zero" ] && continue
  releasing=1
  tag=${remote_ref#refs/tags/}
  notes="docs/releases/$tag.md"
  if [ ! -s "$notes" ] || ! grep -q '[^[:space:]]' "$notes"; then
    echo "push declined: $notes is missing or empty — write the release notes before pushing $tag" >&2
    status=1
    continue
  fi
  # The notes must acknowledge every feat commit between the previous tag
  # and this one — not only the newest feature. Each acknowledgement is a
  # hidden HTML comment carrying the commit oid:
  #
  #   <!--feat:<commit-oid>-->
  #
  # Sharing words with the notes is not coverage: "codex" contains "code",
  # so a Codex-only file would otherwise pass for a Claude Code feat.
  prev=$(git describe --tags --abbrev=0 "$local_oid"^ 2>/dev/null) || continue
  notes_body=$(cat "$notes")
  missing=$(git log "$prev..$local_oid" --no-merges --pretty='%H %s' \
    | grep -E '^[0-9a-f]{40} feat(\(|:)' \
    | while IFS= read -r record; do
        oid=${record%% *}
        # grep -F keeps the marker a plain argument: "<" and ">" inside a
        # case pattern misparse inside command substitution.
        if printf '%s\n' "$notes_body" | grep -qF -- "<!--feat:$oid-->"; then
          :
        else
          printf '%s\n' "$record"
        fi
      done)
  if [ -n "$missing" ]; then
    echo "push declined: $notes does not acknowledge these feat commits since $prev:" >&2
    printf '%s\n' "$missing" >&2
    echo "append the matching hidden comment for each commit" >&2
    printf '%s\n' "$missing" \
      | while IFS= read -r record; do
          oid=${record%% *}
          printf '  <!--feat:%s-->\n' "$oid" >&2
        done
    echo "(paste the comments anywhere into $notes, e.g. at the end) before pushing $tag" >&2
    status=1
  fi
done

# The gate passed for a release tag: the release is now CI's job and the
# local build tree (often 20+ GB after test builds) has served its
# purpose. Pushing reads only .git objects, never target/, so deleting it
# here cannot break the push. Detached: the push must not wait on the
# removal of ~80k build files.
if [ "$status" -eq 0 ] && [ "$releasing" -eq 1 ]; then
  root=$(git rev-parse --show-toplevel)
  if command -v cargo >/dev/null 2>&1 && [ -d "$root/src-tauri/target" ]; then
    echo "release tag verified: cargo clean running in background (src-tauri/target)"
    ( cd "$root/src-tauri" && nohup cargo clean >/dev/null 2>&1 & )
  fi
fi
exit $status
